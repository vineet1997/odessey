# Used by `npm run discover:outreach`. Create an API key at https://exa.ai
# and keep the real value in `.env.local` (which is gitignored).
EXA_API_KEY=

# Used by `npm run enrich:outreach` to inspect only explicitly selected,
# public target pages. Keep the real value in `.env.local`.
FIRECRAWL_API_KEY=

# Server-only Vercel variables for Ithaka's anonymous usage and feedback log.
# Never prefix the service-role key with VITE_ and never expose it in the browser.
SUPABASE_URL=https://tiycurqyfqdcsfrycypm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# The scheduled GitHub Actions RSS collector needs SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY as repository Actions secrets. Its normal and
# release-specific discovery paths use Reddit's public Atom feeds; EXA_API_KEY
# remains only for the separate outreach script. Never prefix secrets with VITE_.

# Founder-only token used by /community-data review mode. Set on Vercel only;
# do not prefix with VITE_ or place the value in a client bundle.
COMMUNITY_REVIEW_TOKEN=
